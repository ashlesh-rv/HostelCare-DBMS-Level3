# PostgreSQL connection string (mandatory SQL database)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/hostel_db

# MongoDB stores complaint activity documents and supports aggregation reports
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=hostel_system

# Required HMAC secret for signed HttpOnly login sessions (generate a random 32+ character value)
SESSION_SECRET=replace_this_with_a_random_secret_at_least_32_characters_long

# Optional: set true when your PostgreSQL host requires SSL
PGSSL=false
